{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "description": "plugins/*/scripts/*.sh で入れるツールの VERSION と SHA256 を更新する (SHA256 は release アセットの digest から算出される。VERSION には GitHub release のタグ名そのものを書く)",
      "customType": "regex",
      "managerFilePatterns": ["/^plugins/[^/]+/scripts/[^/]+\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)\\s+[A-Z0-9_]*VERSION=\"(?<currentValue>[^\"]+)\"\\s+[A-Z0-9_]*SHA256=\"(?<currentDigest>[^\"]+)\"\\s"
      ],
      "versioningTemplate": "semver"
    }
  ]
}
